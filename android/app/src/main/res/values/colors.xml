<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 机身蓝 #4a94c1 与 web UI 一致。
         colorPrimary / colorPrimaryDark / colorAccent 只被 AppTheme 引用，运行时用不到；
         保留 AppTheme 主题块是为了与 Capacitor 模板结构一致，避免 `cap sync` 重新生成时
         产生 diff，但 aapt 仍会校验引用是否存在，所以必须定义。
         deviceBody 被 AppTheme.NoActionBar 的 windowBackground 引用，运行时生效 -->
    <color name="colorPrimary">#4A94C1</color>
    <color name="colorPrimaryDark">#3A7A9F</color>
    <color name="colorAccent">#F8D442</color>
    <color name="deviceBody">#4A94C1</color>
</resources>
